%% C4 Level 2 — Containers and their components
%% Diagrams as code. Render with any Mermaid renderer.
graph TB
    subgraph launcher["Launcher (shell wrapper)"]
        L["backup → export (read-only) → pipeline → $EDITOR → apply → save → assert → read-back → exec gnucash (always)"]
    end

    subgraph pipeline["Pipeline process — venv, never imports gnucash"]
        src["Statement source<br/>paperless | files"]
        plug["ofxstatement plugins"]
        norm["Normaliser<br/>(profile per source account)"]
        dedup["Admission & dedup<br/>(FITID | checksum+ordinal, balance check)"]
        corr["Correlator<br/>(transfers incl. transfers_pending, PayPal per paypal_mode)"]
        docs["Bill matcher<br/>(exact amount, confirmed correspondent, batch-wide)"]
        cls["Classifier<br/>rules → kNN → LLM (one precedence table)"]
        adapter["Model adapter<br/>(redaction boundary, account indices,<br/>local by default)"]
        disp["Disposition<br/>create · create_split · match_existing · out_of_scope · queue"]
        gate["Batch gate<br/>(drift, version tuple)"]
        review["Review file<br/>pre-marked a / ?, save = approval, strict parse"]
        trial["Trial tooling<br/>rolling-origin backtest · rule builder · assistant detector<br/>· pack validator · linkage backtest"]
        staging[("Staging store<br/>SQLite | PostgreSQL")]
    end

    subgraph book["Book process — system Python, links libgnucash (exporter + applier)"]
        session["Session manager<br/>(NORMAL_OPEN | READ_ONLY, save, end in finally)"]
        export["Exporter (read-only)<br/>corpus · CoA · existing · SX definitions"]
        apply["Applier<br/>create · split · match_existing · doc link · read-back"]
        assert["Post-apply assertions<br/>(engine API)"]
    end

    src --> plug --> norm --> dedup --> corr --> docs --> cls --> disp --> gate --> staging
    cls --> adapter
    staging --> review
    review --> staging
    trial --> staging
    export -->|"JSON"| trial
    export -->|"JSON"| cls
    export -->|"JSON: existing, SX definitions"| corr
    staging -->|"JSON: approved rows"| apply
    apply -->|"JSON: proposal_id, tx_guid, status"| staging
    session --- export
    session --- apply
    session --- assert
    L --> pipeline
    L --> book
