%% C4 Level 1 — System context
%% Diagrams as code. Render with any Mermaid renderer.
graph TB
    user["User<br/>(keeps a Beancount ledger, reviews in an editor)"]
    driver["Driver<br/>(separate project: gets statements, runs ofxstatement,<br/>decides when to run, opens the editor, notifies)"]

    subgraph autobook["Autobook"]
        sys["One process: input + pipeline + staging + ledger package"]
    end

    ledger["Beancount ledger files<br/>(main file and its includes, all read;<br/>one owned file, the only one written)"]
    viewer["Fava or a text editor"]
    paperless["paperless-ngx<br/>bills"]
    model["Model backend<br/>(optional, OpenAI-compatible,<br/>local by default)"]
    secrets["Secret Service<br/>(libsecret)"]
    packs["Rule-pack repository<br/>(separate, versioned)"]

    user -->|"starts or schedules"| driver
    driver -->|"shows the review file, notifies"| user
    user -->|"approves by saving the review file"| driver
    driver -->|"OFX files, optional producer string,<br/>the saved review file"| sys
    sys -->|"exit code, --json output, review file"| driver
    sys -->|"reads every file; writes transactions<br/>to the owned file only"| ledger
    user -->|"reads and edits the ledger"| viewer
    viewer -->|"opens"| ledger
    sys -->|"REST, read; optional stamp"| paperless
    sys -->|"token, account indices, amount, sign<br/>(remote: allowlisted tokens only)"| model
    sys -->|"tokens, API keys"| secrets
    packs -->|"pattern → category data"| sys
